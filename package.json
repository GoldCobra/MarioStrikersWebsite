{
  "name": "mario-strikers-website",
  "version": "1.0.0",
  "private": true,
  "description": "Community guides, rankings and tools for Mario Strikers.",
  "workspaces": [
    "apps/api",
    "tests/e2e"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@ms/api",
    "dev:live": "npm run dev:live --workspace=@ms/api",
    "start": "npm start --workspace=@ms/api",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check --workspace=@ms/api",
    "check:frontend": "npm run check:frontend --workspace=@ms/api",
    "typecheck": "tsc -p tests/e2e",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspace=@ms/api",
    "test:smoke": "npm run test:smoke --workspace=@ms/api",
    "test:visual": "npm run visual --workspace=@ms/e2e",
    "test:dom": "npm run dom --workspace=@ms/e2e",
    "test:contract": "npm run contract --workspace=@ms/e2e"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
