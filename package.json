{
  "name": "mario-strikers-website",
  "version": "1.0.0",
  "private": true,
  "description": "Community guides, rankings and tools for Mario Strikers.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared",
    "tools",
    "tests/e2e"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node tools/src/dev.ts",
    "dev:live": "node tools/src/dev.ts --live",
    "build": "npm run build --workspace=@ms/web",
    "preview": "npm run build && node tools/src/fixture-stack.ts",
    "start": "npm start --workspace=@ms/api",
    "check": "npm run typecheck && npm run lint && npm run format:check && node tools/src/generate-nginx-routes.ts --check && npm run check --workspace=@ms/api",
    "check:frontend": "npm run check:frontend --workspace=@ms/api",
    "typecheck": "tsc -p packages/shared && tsc -p tools && tsc -p tests/e2e && npm run check --workspace=@ms/web",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:nginx": "node tools/src/generate-nginx-routes.ts",
    "test": "npm test --workspaces --if-present",
    "test:smoke": "npm run test:smoke --workspace=@ms/api",
    "test:visual": "node tests/e2e/run.ts visual",
    "test:dom": "node tests/e2e/run.ts dom",
    "test:contract": "node tests/e2e/run.ts contract"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
