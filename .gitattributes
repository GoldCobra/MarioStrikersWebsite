# Normalize text when touched; do not mass-renormalize unrelated files.
* text=auto

*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
Dockerfile* text eol=lf
Caddyfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.node-version text eol=lf
.nvmrc text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.psd binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
