FROM node:24-alpine
ARG RELEASE_SHA=development
LABEL org.opencontainers.image.revision=$RELEASE_SHA

# The working directory stays /app: the API resolves its cache and .env paths from it,
# and production mounts the persistent cache volume at /app/.cache.
WORKDIR /app

# Workspace manifests first, so the dependency layer is reused until they change.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN npm ci --omit=dev --workspace=@ms/api --no-audit --no-fund

# Node runs the TypeScript sources directly (type stripping); there is no build step.
COPY packages/shared/src/ packages/shared/src/
COPY apps/api/ apps/api/

EXPOSE 8787

CMD ["node", "apps/api/src/main.ts"]
