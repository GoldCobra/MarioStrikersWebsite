# Mario Strikers Community Website — Backend Environment
# Copy this file to .env and fill in the values.
# .env is git-ignored and must never be committed.

# Port the Express API listens on (Nginx proxies /api/* to this port)
PORT=8787

# Allowed frontend origin(s) for CORS.
# Production: set to your exact domain, e.g. https://mariostrikerscommunity.com
# Multiple domains: comma-separated, e.g. https://example.com,https://www.example.com
# Local dev only: * (allow all)
CORS_ORIGIN=*

# Leaderboard pagination limits
LEADERBOARD_DEFAULT_LIMIT=100
LEADERBOARD_MAX_LIMIT=500

# Microsoft SQL Server connection
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
