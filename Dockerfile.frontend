# Build stage: renders the static site with Astro.
FROM node:24-alpine AS build
WORKDIR /app

# Workspace manifests first, so the dependency layer is reused until they change.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace=@ms/web --no-audit --no-fund

# Shared TypeScript settings that packages/shared and apps/web extend.
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY apps/web/ apps/web/
RUN npm run build --workspace=@ms/web

# Runtime stage: nginx serves the built files.
FROM alpine:3.22
ARG RELEASE_SHA=development
LABEL org.opencontainers.image.revision=$RELEASE_SHA

RUN apk add --no-cache nginx nginx-mod-http-brotli \
    && mkdir -p /run/nginx /usr/share/nginx/html /etc/nginx/snippets \
    && rm -f /etc/nginx/http.d/default.conf

WORKDIR /usr/share/nginx/html

COPY --from=build /app/apps/web/dist/ ./
COPY infra/nginx/frontend.conf /etc/nginx/http.d/default.conf
COPY infra/nginx/generated/legacy-routes.conf /etc/nginx/snippets/legacy-routes.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
