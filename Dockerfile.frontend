# Build stage: renders the static site with Astro.
# Base images are pinned by digest; Dependabot proposes updates (.github/dependabot.yml).
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /app

# Workspace manifests first, so the dependency layer is reused until they change.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace=@ms/web --no-audit --no-fund

# Shared TypeScript settings that packages/shared and apps/web extend.
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY apps/web/ apps/web/
RUN npm run build --workspace=@ms/web

# Runtime stage: nginx serves the built files.
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
ARG RELEASE_SHA=development
LABEL org.opencontainers.image.revision=$RELEASE_SHA

RUN apk add --no-cache nginx nginx-mod-http-brotli \
    && mkdir -p /run/nginx /usr/share/nginx/html /usr/share/nginx/private /etc/nginx/snippets \
    && rm -f /etc/nginx/http.d/default.conf \
    && chown -R nginx:nginx /run/nginx /var/lib/nginx /var/log/nginx

WORKDIR /usr/share/nginx/html

COPY --from=build /app/apps/web/dist/ ./
# The hidden admin page, outside the web root: nginx serves it only behind the admin gate (docs/adr/0011).
COPY --from=build /app/apps/web/dist-private/ /usr/share/nginx/private/
COPY infra/nginx/frontend.conf /etc/nginx/http.d/default.conf
COPY infra/nginx/generated/legacy-routes.conf /etc/nginx/snippets/legacy-routes.conf
COPY infra/nginx/snippets/document-headers.conf /etc/nginx/snippets/document-headers.conf

# nginx runs as its unprivileged user; it listens on 8080, so it needs no root privileges.
USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
