---
// Text pages: one content box in the setup guide layout. The default slot is the box's content,
// the "after" slot follows the box (e.g. a credits line).
import SiteLayout from "../../layouts/SiteLayout.astro";

interface Props {
  slug: string;
  /** Accessible name of the page's section; the article is "<label> content". */
  label: string;
}

const { slug, label } = Astro.props;
---
<SiteLayout slug={slug} mainClass="competitive-rules-page setup-guide-page">
    <section id={`${slug}-root`} aria-label={label}>
      <article class="competitive-rules setup-guide-article content-box-list" aria-label={`${label} content`}>
        <section class="content-box cr-section setup-guide-section">
          <div class="content-box-top" aria-hidden="true"><div class="content-box-top-left"></div><div class="content-box-top-main"></div></div>
          <div class="content-box-center">
            <div class="content-box-texture" aria-hidden="true"></div>
            <div class="content-box-content"><slot /></div>
          </div>
          <div class="content-box-bottom" aria-hidden="true"></div>
        </section>
        <slot name="after" />
      </article>
    </section>
  </SiteLayout>
