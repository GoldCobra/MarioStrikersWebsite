---
// Leaderboard pages; leaderboards-config.js picks the game and mode from the page slug.
import SiteLayout from "../../layouts/SiteLayout.astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---
<SiteLayout
  slug={slug}
  scripts={["leaderboardsConfig", "leaderboardsEngine"]}
>
    <section id="leaderboards-root" aria-label="Leaderboards"></section>
  <Fragment slot="scripts"><script src="../../entries/leaderboard-page.ts"></script></Fragment></SiteLayout>
