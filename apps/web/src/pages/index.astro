---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout slug="index" scripts={["globalTabsEngine", "globalNav", "landingCountdown"]}>
    <section class="landing-club landing-club--competitive-season" aria-label="Competitive Season">
      <img class="landing-club-image" src="/assets/landing/comp-season-dusk.png" alt="Competitive Season Dusk" width="840" height="407" decoding="async" fetchpriority="high">
      <p class="landing-club-label">COMPETITIVE SEASON</p>
      <div class="landing-club-overlay" aria-live="polite">
        <div class="landing-club-text-block">
          <p class="landing-club-headline">COMPETITIVE SEASON</p>
          <p class="landing-season-countdown landing-club-countdown" data-competitive-season-countdown><span class="landing-countdown-prefix">SEASON BEGINS:</span><span class="landing-countdown-group"><span class="landing-countdown-segment"><span class="landing-countdown-char">0</span><span class="landing-countdown-char">0</span><span class="landing-countdown-char landing-countdown-char-unit">D</span></span><span class="landing-countdown-segment"><span class="landing-countdown-char">0</span><span class="landing-countdown-char">0</span><span class="landing-countdown-char landing-countdown-char-unit">H</span></span><span class="landing-countdown-segment"><span class="landing-countdown-char">0</span><span class="landing-countdown-char">0</span><span class="landing-countdown-char landing-countdown-char-unit">M</span></span></span></p>
        </div>
      </div>
    </section>
    <section class="landing-club" aria-label="Mario Strikers Club">
      <img class="landing-club-image" src="/assets/landing/strikers-club.png" alt="Mario Strikers Club" width="840" height="407" decoding="async" fetchpriority="high">
      <p class="landing-club-label">STRIKERS CLUB</p>
      <div class="landing-club-overlay" aria-live="polite">
        <div class="landing-club-text-block">
          <p class="landing-club-headline">THE SEASON IS UNDERWAY!</p>
          <p class="landing-season-countdown landing-club-countdown" data-local-season-countdown><span class="landing-countdown-prefix">SEASON ENDS IN</span><span class="landing-countdown-group"><span class="landing-countdown-segment"><span class="landing-countdown-char">0</span><span class="landing-countdown-char">0</span><span class="landing-countdown-char landing-countdown-char-unit">D</span></span><span class="landing-countdown-segment"><span class="landing-countdown-char">0</span><span class="landing-countdown-char">0</span><span class="landing-countdown-char landing-countdown-char-unit">H</span></span><span class="landing-countdown-segment"><span class="landing-countdown-char">0</span><span class="landing-countdown-char">0</span><span class="landing-countdown-char landing-countdown-char-unit">M</span></span></span></p>
        </div>
      </div>
    </section>
  </SiteLayout>
