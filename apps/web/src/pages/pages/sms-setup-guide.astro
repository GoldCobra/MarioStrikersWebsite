---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout slug="sms-setup-guide" mainClass="competitive-rules-page setup-guide-page" scripts={["globalTabsEngine", "globalNav"]}>
    <section id="sms-setup-guide-root" aria-label="SMS setup guide">
      <article class="competitive-rules setup-guide-article content-box-list" aria-label="SMS setup guide content">
        <section class="content-box cr-section setup-guide-section">
          <div class="content-box-top" aria-hidden="true"><div class="content-box-top-left"></div><div class="content-box-top-main"></div></div>
          <div class="content-box-center">
            <div class="content-box-texture" aria-hidden="true"></div>
            <div class="content-box-content">
          <h2>SUPER MARIO STRIKERS SETUP GUIDE</h2>
          <figure class="setup-guide-media setup-guide-video">
            <div class="setup-guide-video-frame">
              <iframe
                src="https://www.youtube.com/embed/T_DNKJ5d0s8"
                title="Super Mario Strikers Setup Guide"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
            </div>
          </figure>
            </div>
          </div>
          <div class="content-box-bottom" aria-hidden="true"></div>
        </section>
        <div class="setup-guide-meta-line">
          <p class="setup-guide-credits">Credits @Randomepicdude</p>
        </div>
      </article>
    </section>
  </SiteLayout>
