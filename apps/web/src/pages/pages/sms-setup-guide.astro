---
import ContentPage from "../../components/pages/ContentPage.astro";
---
<ContentPage slug="sms-setup-guide" label="SMS setup guide">
          <h2>SUPER MARIO STRIKERS SETUP GUIDE</h2>
          <figure class="setup-guide-media setup-guide-video">
            <div class="setup-guide-video-frame">
              <iframe
                src="https://www.youtube.com/embed/T_DNKJ5d0s8"
                title="Super Mario Strikers Setup Guide"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
            </div>
          </figure>
        <div slot="after" class="setup-guide-meta-line">
          <p class="setup-guide-credits">Credits @Randomepicdude</p>
        </div>
  </ContentPage>
