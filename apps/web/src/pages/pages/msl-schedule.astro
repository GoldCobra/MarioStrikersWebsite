---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout slug="msl-schedule" mainClass="msl-schedule-page" scripts={["globalTabsEngine", "globalNav"]}>
    <section id="msl-schedule-root" class="msl-schedule-root" aria-label="MSL schedule contents">
      <article class="msl-schedule-list" aria-label="MSL 2026 events">
        <section class="msl-schedule-item">
          <h2 class="msl-schedule-title is-world">MSL 2026 WORLD CHAMPIONSHIP</h2>
          <p class="msl-schedule-meta">Date: TBA</p>
          <p class="msl-schedule-meta">Signup: TBA</p>
        </section>

        <section class="msl-schedule-item">
          <h2 class="msl-schedule-banner-title"><img class="msl-schedule-banner" src="/assets/msl/banner-fall.png" alt="MSL 2026 Fall Split"></h2>
          <p class="msl-schedule-meta">Date: TBA</p>
          <p class="msl-schedule-meta">Signup: TBA</p>
        </section>

        <section class="msl-schedule-item">
          <h2 class="msl-schedule-banner-title"><img class="msl-schedule-banner" src="/assets/msl/banner-summer.png" alt="MSL 2026 Summer Split"></h2>
          <p class="msl-schedule-meta">July 30 - October 31, 2026</p>
          <p class="msl-schedule-meta">Signup: <a href="https://www.start.gg/tournament/msl-2026-summer-series/register" target="_blank" rel="noopener noreferrer">https://www.start.gg/tournament/msl-2026-summer-series/register</a></p>
        </section>

        <section class="msl-schedule-item">
          <h2 class="msl-schedule-banner-title"><img class="msl-schedule-banner" src="/assets/msl/banner-spring.png" alt="MSL 2026 Spring Split"></h2>
          <p class="msl-schedule-meta">March 10 - June 20, 2026</p>
          <p class="msl-schedule-meta">Signup: <a href="https://www.start.gg/tournament/msl-2026-spring-series/register" target="_blank" rel="noopener noreferrer">https://www.start.gg/tournament/msl-2026-spring-series/register</a></p>
        </section>
      </article>
    </section>
  </SiteLayout>
