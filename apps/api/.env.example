# Live API settings (npm start, npm run dev:live). Copy to .env; the fixture API (npm run dev) never reads it.
# Empty values fall back to the defaults shown in src/config.ts.

# Server
PORT=8787
HOST=0.0.0.0
# fatal, error, warn, info, debug, trace or silent (default: info in production, warn otherwise)
LOG_LEVEL=
# Reverse proxies in front of the API whose X-Forwarded-For entries are trusted (production: 2, Caddy and nginx)
TRUST_PROXY_HOPS=0
# Per-IP limits on uncached routes (default: on in production)
RATE_LIMIT_ENABLED=
CORS_ORIGIN=*

# Leaderboards and shared public data
LEADERBOARD_DEFAULT_LIMIT=100
LEADERBOARD_MAX_LIMIT=500
PUBLIC_DATA_CACHE_TTL_MS=60000
PUBLIC_DATA_CACHE_REFRESH_INTERVAL_MS=60000
PUBLIC_DATA_CACHE_PARALLELISM=2
PUBLIC_DATA_CACHE_SNAPSHOT_PATH=.cache/public-data-cache.json

# Club logos, downloaded once and served from the local cache
CLUB_LOGO_CACHE_PATH=.cache/club-logos
CLUB_LOGO_MAX_BYTES=5242880
CLUB_LOGO_FETCH_TIMEOUT_MS=15000
CLUB_LOGO_FAILURE_RETRY_MS=21600000

# Player titles: how often the API awards new ones (season ends, tournament results); 0 switches it off
TITLE_SYNC_INTERVAL_MS=86400000

# FlareSolverr for Wiimmfi CF bypass (Docker: http://flaresolverr:8191, local: http://localhost:8191)
FLARESOLVERR_URL=http://localhost:8191

# Discord OAuth login. Register this exact redirect URI in the Discord Developer Portal.
# Login stays switched off until the client, guild and SESSION_SECRET are all set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_API_BASE=https://discord.com/api/v10
# Bot token for community events and roster names (BOT_TOKEN is accepted as an alias)
DISCORD_BOT_TOKEN=
DISCORD_EVENTS_CATEGORY_ID=
DISCORD_EVENTS_REFRESH_INTERVAL_MS=3600000
DISCORD_MEMBER_CACHE_TTL_MS=3600000
DISCORD_MEMBER_FAILURE_CACHE_TTL_MS=60000
DISCORD_MEMBER_FETCH_TIMEOUT_MS=5000
DISCORD_MEMBER_FETCH_PARALLELISM=4
# At least 32 random characters in production, e.g. node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=msc_session
# Default: true in production
SESSION_COOKIE_SECURE=false
SESSION_TTL_MS=604800000
AUTH_STATE_TTL_MS=600000

# MSSQL (required in production)
MSSQL_HOST=
MSSQL_PORT=443
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_POOL_MIN=1
MSSQL_POOL_MAX=10
MSSQL_POOL_IDLE_TIMEOUT_MS=300000
MSSQL_CONNECTION_TIMEOUT_MS=15000
MSSQL_REQUEST_TIMEOUT_MS=15000
# Keep true and TLSv1 until the database host's certificate and TLS versions have been probed
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_TLS_MIN_VERSION=TLSv1
